# Exclude local node_modules and caches
node_modules/
.expo/
.expo-shared/
**/.DS_Store
**/Thumbs.db
npm-debug.*
yarn-debug.log*
yarn-error.log*

# Expo generated files
expo-env.d.ts
.env

# Local build and packaging artifacts
/dist/
/web-build/
build/
build/**
*.map
*.log
*.tmp
*.temp
*.orig.*
*.pid
*.lock

# Local project-only folders that are not needed for EAS managed builds
.git/
.github/
docs/
scripts/
android_disabled/
*.md
PREVIEW_ARTIFACT.md

eas_build_*.txt
eas_build_view.json
error.txt

# Ignore local/react-native native folders for managed Expo builds
android/
ios/

# Android build artifacts
android/.gradle/
android/app/build/
android/build/
android/.cxx/
android/*.keystore
android/*.jks
android/*.p12
android/*.p8
android/*.key
android/*.mobileprovision

# iOS build artifacts
ios/Pods/
ios/build/
*.xcworkspace
*.xcuserdata
*.xcodeproj/project.xcworkspace/

# IDE and editor files
.vscode/
.idea/
*.iml

# Temporary files
*~
